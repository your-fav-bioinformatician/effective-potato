{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "_id",
    "user_id"
  ],
  "properties": {
    "_id": {
      "$ref": "#/$defs/ObjectId"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "answer",
          "id"
        ],
        "properties": {
          "answer": {
            "type": "integer"
          },
          "id": {
            "type": "integer"
          }
        }
      }
    },
    "created_at": {
      "type": "string"
    },
    "final_user_vector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Double"
      }
    },
    "mbti_vector": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Double"
      }
    },
    "status": {
      "type": "string"
    },
    "updated_at": {
      "$ref": "#/$defs/Date"
    },
    "user_id": {
      "type": "integer"
    }
  },
  "$defs": {
    "ObjectId": {
      "type": "object",
      "properties": {
        "$oid": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{24}$"
        }
      },
      "required": [
        "$oid"
      ],
      "additionalProperties": false
    },
    "Double": {
      "oneOf": [
        {
          "type": "number"
        },
        {
          "type": "object",
          "properties": {
            "$numberDouble": {
              "enum": [
                "Infinity",
                "-Infinity",
                "NaN"
              ]
            }
          }
        }
      ]
    },
    "Date": {
      "type": "object",
      "properties": {
        "$date": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "$date"
      ],
      "additionalProperties": false
    }
  }
}